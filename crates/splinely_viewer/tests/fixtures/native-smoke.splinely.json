{
  "name": "Native smoke",
  "width": 400,
  "height": 300,
  "nodes": [
    {
      "id": "button",
      "kind": {
        "type": "rect",
        "x": 100,
        "y": 100,
        "width": 200,
        "height": 100,
        "rx": 0
      }
    },
    {
      "id": "status",
      "kind": {
        "type": "rect",
        "x": 100,
        "y": 240,
        "width": 200,
        "height": 30,
        "rx": 0
      }
    }
  ],
  "stateMachines": [
    {
      "id": "interaction",
      "initial": "idle",
      "states": [
        {
          "id": "idle",
          "overrides": [
            {
              "nodeId": "button",
              "property": "fill",
              "value": {
                "type": "color",
                "value": {
                  "r": 1,
                  "g": 0,
                  "b": 0,
                  "a": 1
                }
              }
            }
          ]
        },
        {
          "id": "hover",
          "overrides": [
            {
              "nodeId": "button",
              "property": "fill",
              "value": {
                "type": "color",
                "value": {
                  "r": 0,
                  "g": 1,
                  "b": 0,
                  "a": 1
                }
              }
            }
          ]
        },
        {
          "id": "clicked",
          "overrides": [
            {
              "nodeId": "button",
              "property": "fill",
              "value": {
                "type": "color",
                "value": {
                  "r": 0,
                  "g": 0,
                  "b": 1,
                  "a": 1
                }
              }
            }
          ]
        }
      ],
      "transitions": [
        {
          "from": "idle",
          "to": "hover",
          "event": {
            "name": "pointerenter",
            "target": "button"
          }
        },
        {
          "from": "hover",
          "to": "idle",
          "event": {
            "name": "pointerleave",
            "target": "button"
          }
        },
        {
          "from": "hover",
          "to": "clicked",
          "event": {
            "name": "click",
            "target": "button"
          }
        },
        {
          "from": "idle",
          "to": "clicked",
          "event": {
            "name": "click",
            "target": "button"
          }
        }
      ]
    }
  ],
  "audioAssets": [
    {
      "id": "beep",
      "name": "smoke beep",
      "mimeType": "audio/wav",
      "dataBase64": ""
    }
  ],
  "customJs": "splinely.set('status',{fill:{r:1,g:0,b:1,a:1}});splinely.on('click',async()=>{if(splinely.audio.ready){splinely.audio.play('beep');splinely.set('status',{fill:{r:0,g:1,b:1,a:1}});}});"
}
